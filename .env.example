# Runtime
NODE_ENV=development
API_VERSION=v1
LOG_LEVEL=info
REQUEST_BODY_LIMIT=1mb

# Standard local development ports
FRONTEND_PORT=3000
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Backend API URL used by frontend integrations.
VITE_API_BASE_URL=http://localhost:4000

# Core app database
DATABASE_URL="postgresql://user:password@host:5432/yatrivo?sslmode=require"
DATABASE_SSL=true
DB_POOL_MAX=10

# S3-compatible object storage
AWS_ENDPOINT_URL_S3="https://your-storage-endpoint.example.com"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="ap-southeast-1"
AWS_BUCKET_NAME="yatrivo-media"

# Redis / Upstash
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Auth / session security
JWT_ACCESS_TOKEN_SECRET=""
JWT_REFRESH_TOKEN_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
